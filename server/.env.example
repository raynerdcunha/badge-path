# Everything here is OPTIONAL. The app works with no .env file at all.

# Port for the API (the web page expects 3001 by default).
PORT=3001

# Web pages allowed to call the API (comma separated). Default is the local web server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute allowed from one address (the page asks every 5 seconds = 12 per minute).
RATE_LIMIT=60
